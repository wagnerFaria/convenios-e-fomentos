# Variáveis do docker-compose.dev.yml. Copie para ".env" (ignorado pelo git):
#
#   cp .env.example .env
#
# Todas são opcionais: sem este arquivo valem os padrões de desenvolvimento do compose.
# Variáveis exportadas no shell têm precedência sobre o .env.

# ---------------------------------------------------------------------------
# Portas publicadas no host
# ---------------------------------------------------------------------------
# Se alguma estiver ocupada, troque aqui. PUBLIC_URL, CORS_ALLOWED_ORIGINS e
# NEXT_PUBLIC_APP_URL acompanham WEB_EXTERNAL_PORT automaticamente.
WEB_EXTERNAL_PORT=3000
API_EXTERNAL_PORT=8080
DB_PORT=5432

# ---------------------------------------------------------------------------
# Usuário do host (arquivos gerados nos volumes ficam com o seu dono)
# ---------------------------------------------------------------------------
# Confira com `id -u` e `id -g`.
UID=1000
GID=1000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# URL de conexão usada pelos contêineres. Por padrão é montada a partir de POSTGRES_*
# (host "db" na rede do Docker); só defina para apontar para outro banco. Se a senha tiver
# caracteres especiais, aplique URL-encode. Cuidado: o shell do host pode exportar uma
# DATABASE_URL (modo sem Docker, apontando para localhost) que sobrescreveria esta.
# DATABASE_URL=postgres://app:app@db:5432/app?sslmode=disable

# ---------------------------------------------------------------------------
# Backend (API em Go) — veja backend/.env.example para a lista completa
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# Os links dos e-mails (convite, redefinição de senha) abrem o frontend. Por padrão acompanham
# WEB_EXTERNAL_PORT; só defina para usar outro domínio (ex.: túnel ou host na rede local).
# PUBLIC_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Rede padrão do Docker: o backend confia no X-Forwarded-For enviado pelo Next (rate limit por IP).
TRUSTED_PROXIES=172.16.0.0/12

# Segredos: estes valores servem SOMENTE para desenvolvimento.
JWT_API_SECRET=dev-only-api-secret-change-me-000000000000
API_TOKEN_SALT=dev-only-api-token-salt-change-me-0000000

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_MAX_TTL=720h
REFRESH_TOKEN_IDLE_TTL=168h
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# E-mail: sem SMTP_HOST os e-mails só aparecem no log da API (docker compose logs api).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# ---------------------------------------------------------------------------
# Login dos administradores — MT Login (Keycloak)
# ---------------------------------------------------------------------------
# OBRIGATÓRIO: sem estas variáveis a API não sobe e o botão "Entrar" mostra erro de configuração.
# O frontend conduz o login (Authorization Code + PKCE) e a API só valida o access token.
# Cadastre no client do Keycloak: a URL de retorno (MTLOGIN_REDIRECT_URI) e a de pós-logout
# (<origem do frontend>/auth/sign-in).
MTLOGIN_AUTHORIZATION_URI="https://hml.login.mt.gov.br/auth/realms/mt-realm/protocol/openid-connect/auth"
MTLOGIN_TOKEN_URI="https://hml.login.mt.gov.br/auth/realms/mt-realm/protocol/openid-connect/token"
MTLOGIN_END_SESSION_URI="https://hml.login.mt.gov.br/auth/realms/mt-realm/protocol/openid-connect/logout"
MTLOGIN_CLIENT_ID=projeto-template-integracao
# Só para clients confidenciais; para client público (PKCE) deixe em branco.
# MTLOGIN_CLIENT_SECRET=
# Padrão: http://localhost:$WEB_EXTERNAL_PORT/auth/callback
# MTLOGIN_REDIRECT_URI=http://localhost:3000/auth/callback

# Validação dos tokens pela API.
JWKS_URI="https://hml.login.mt.gov.br/auth/realms/mt-realm/protocol/openid-connect/certs"
OIDC_ISSUER="https://hml.login.mt.gov.br/auth/realms/mt-realm"
# Claim do access token que traz o CPF, a chave de identidade do administrador.
OIDC_CPF_CLAIM=preferred_username

# CPFs (separados por vírgula) que o seed torna Super Admin. Sem isto, ninguém tem permissões no
# primeiro acesso: o login cria o administrador, mas sem perfil.
SEED_SUPER_ADMIN_CPF=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# URL da API usada pelo servidor do Next, pela rede do Docker.
API_URL=http://api:8080
# NEXT_PUBLIC_APP_URL=http://localhost:3000   # padrão: acompanha WEB_EXTERNAL_PORT
NEXT_PUBLIC_SENTRY_DISABLED=true
NEXT_TELEMETRY_DISABLED=1
# "true" no macOS/Windows se o HMR não detectar mudanças.
WATCHPACK_POLLING=false
