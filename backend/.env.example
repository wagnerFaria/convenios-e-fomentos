# Ambiente: development | test | production
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
PUBLIC_URL=http://localhost:8080

DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Segredos. Em produção são obrigatórios, com >= 32 caracteres aleatórios
# (ex.: openssl rand -hex 32) e JWT_ADMIN_SECRET != JWT_API_SECRET.
JWT_ADMIN_SECRET=dev-only-admin-secret-change-me-0000000000
JWT_API_SECRET=dev-only-api-secret-change-me-000000000000
API_TOKEN_SALT=dev-only-api-token-salt-change-me-0000000

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_MAX_TTL=720h
REFRESH_TOKEN_IDLE_TTL=168h

# Lista separada por vírgulas
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MINUTE=10
# Limite geral por IP em todas as rotas (0 desliga)
RATE_LIMIT_GLOBAL_PER_MINUTE=600
MAX_BODY_BYTES=1048576
PASSWORD_MIN_LENGTH=8

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Argon2id (padrão OWASP: 19 MiB, 2 iterações, 1 thread)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Validade dos tokens de uso único (convite e redefinição de senha)
INVITE_TOKEN_TTL=168h
RESET_TOKEN_TTL=30m
EMAIL_CONFIRMATION_TTL=72h

# CIDRs de proxies reversos confiáveis (lista separada por vírgulas).
# Somente requisições vindas deles têm o X-Forwarded-For considerado.
TRUSTED_PROXIES=

# Porta do PostgreSQL publicada no host pelo Compose (mude se a 5432 estiver ocupada;
# ajuste a DATABASE_URL para a mesma porta).
DB_PORT=5432

# Registro inicial do primeiro Super Admin por HTTP (POST /admin/auth/register-first).
# Sem valor: habilitado fora de produção e desabilitado em produção (use a CLI: admin:create).
INITIAL_REGISTRATION_ENABLED=
