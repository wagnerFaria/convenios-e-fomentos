# Ambiente: development | test | production
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
PUBLIC_URL=http://localhost:8080

DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Login dos administradores pelo MT Login (Keycloak/OIDC). O frontend conduz o login e a API só
# valida o access token: assinatura (chaves do JWKS), emissor e client. Obrigatórios para subir a API.
JWKS_URI=https://hml.login.mt.gov.br/auth/realms/mt-realm/protocol/openid-connect/certs
OIDC_ISSUER=https://hml.login.mt.gov.br/auth/realms/mt-realm
OIDC_CLIENT_ID=projeto-template-integracao
# Claim do access token que traz o CPF (a chave de identidade do administrador).
OIDC_CPF_CLAIM=preferred_username
# CPFs (separados por vírgula) que o seed torna Super Admin. Quem ainda não existe é criado e o
# nome e o e-mail vêm do MT Login no primeiro acesso. Também há a CLI: admin:create --cpf.
SEED_SUPER_ADMIN_CPF=

# Segredos. Em produção são obrigatórios, com >= 32 caracteres aleatórios
# (ex.: openssl rand -hex 32). Os JWTs dos usuários finais (/api/*) usam JWT_API_SECRET.
JWT_API_SECRET=dev-only-api-secret-change-me-000000000000
API_TOKEN_SALT=dev-only-api-token-salt-change-me-0000000

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_MAX_TTL=720h
REFRESH_TOKEN_IDLE_TTL=168h

# Lista separada por vírgulas
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MINUTE=10
# Limite geral por IP em todas as rotas (0 desliga)
RATE_LIMIT_GLOBAL_PER_MINUTE=600
# Pedidos/confirmações de envio de arquivo de projeto por usuário (0 desliga)
RATE_LIMIT_UPLOAD_PER_MINUTE=120
MAX_BODY_BYTES=1048576
PASSWORD_MIN_LENGTH=8

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Armazenamento S3 (MinIO) dos arquivos dos documentos. Sem STORAGE_ENDPOINT as rotas de arquivos
# respondem 503. STORAGE_PUBLIC_URL é a URL vista pelo navegador (mesmo domínio da aplicação, com o
# prefixo do proxy): as URLs pré-assinadas são calculadas sobre o host dela.
STORAGE_ENDPOINT=
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=documentos
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost/storage
STORAGE_UPLOAD_TTL=15m
STORAGE_DOWNLOAD_TTL=2m
# Antivírus ClamAV (host:porta do clamd) para os arquivos dos projetos; vazio = sem varredura.
# O clamd precisa de StreamMaxLength >= 200M.
CLAMAV_ADDR=

# Argon2id (padrão OWASP: 19 MiB, 2 iterações, 1 thread)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Validade do link de redefinição de senha dos usuários finais
RESET_TOKEN_TTL=30m
EMAIL_CONFIRMATION_TTL=72h

# CIDRs de proxies reversos confiáveis (lista separada por vírgulas).
# Somente requisições vindas deles têm o X-Forwarded-For considerado.
TRUSTED_PROXIES=

# Porta do PostgreSQL publicada no host pelo Compose (mude se a 5432 estiver ocupada;
# ajuste a DATABASE_URL para a mesma porta).
DB_PORT=5432
